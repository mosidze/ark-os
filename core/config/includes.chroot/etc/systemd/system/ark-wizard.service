[Unit]
Description=ARK first-boot wizard
After=ark-detect.service network-online.target avahi-daemon.service
Wants=ark-detect.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/ark-wizard
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
